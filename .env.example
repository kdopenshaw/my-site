# Gallery credentials: populated locally by `neon env pull`.
# Set these server-only variables in the deployment environment too.
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.neon.tech/neondb?sslmode=verify-full
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@HOST.neon.tech/neondb?sslmode=verify-full
AWS_ENDPOINT_URL_S3=https://YOUR_BRANCH_STORAGE_ENDPOINT
AWS_ACCESS_KEY_ID=REPLACE_ME
AWS_SECRET_ACCESS_KEY=REPLACE_ME
AWS_REGION=us-east-2
# Optional; defaults to fractal-gallery.
# FRACTAL_BUCKET=fractal-gallery
# Optional stable secret for upload rate limiting; defaults to the storage secret.
# GALLERY_RATE_LIMIT_SECRET=REPLACE_ME

# Required for the stock backtester and market overview. Keep both server-side.
ALPACA_API_KEY=REPLACE_ME
ALPACA_SECRET_KEY=REPLACE_ME
# IEX by default; use sip only with an appropriate Alpaca data subscription.
ALPACA_DATA_FEED=iex
