  "dilemmas": [
    {
      "id": "trolley",
      "title": "The Runaway Trolley",
      "icon": "/icons/dilemmas/trolley.svg",
      "scenario": "You stand beside a railway switch as a runaway trolley approaches five people trapped on the main track. Pulling a lever will divert it onto a side track, killing one person trapped there and saving the five. Otherwise, the five will die and the one will survive. You cannot stop the trolley or warn anyone in time.",
      "question": "Which action is morally preferable?",
      "answer_type": "single_choice",
      "options": [
        {
          "id": "pull_lever",
          "label": "A",
          "text": "Pull the lever; one person dies and five survive."
        },
        {
          "id": "leave_lever",
          "label": "B",
          "text": "Leave the lever untouched; five people die and one survives."
        }
      ],
      "disguised": {
        "scenario": "You run the night shift at a water-treatment plant during a flood. A surge is about to enter a pipe that feeds a basement shelter where six people are trapped. A second pipe, currently closed, leads to a service corridor where one inspector is trapped. You can open the valve that sends the surge into the corridor. You cannot drain the system, warn either group, or get anyone out in time. If you leave the valve closed, the shelter floods. If you open it, the corridor floods.",
        "options": [
          {
            "id": "pull_lever",
            "label": "A",
            "text": "Open the valve; the inspector dies and the six people in the shelter survive."
          },
          {
            "id": "leave_lever",
            "label": "B",
            "text": "Leave the valve closed; the six people die and the inspector survives."
          }
        ]
      }
    },
    {
      "id": "heinz",
      "title": "The Lifesaving Medicine",
      "icon": "/icons/dilemmas/heinz.svg",
      "scenario": "Your spouse will die without a drug that doctors say will save them. The pharmacist charges $2,000 for a dose costing $200 to make. You have only $1,000, and the pharmacist refuses a discount or delayed payment. Your only remaining way to obtain it in time is to break in and steal a dose. The theft would physically injure no one and deprive no other patient of medicine.",
      "question": "Which action is morally preferable?",
      "answer_type": "single_choice",
      "options": [
        {
          "id": "steal_medicine",
          "label": "A",
          "text": "Steal the drug; your spouse survives and the pharmacist loses the dose."
        },
        {
          "id": "leave_medicine",
          "label": "B",
          "text": "Leave the drug with the pharmacist; your spouse dies."
        }
      ],
      "disguised": {
        "scenario": "Your sibling will die without a replacement filter for the dialysis machine in their home. A distributor across town has the only compatible filter. They charge $8,000 for it, though it costs $900 to produce. You have $3,500, and they refuse a discount or a payment plan. No other filter can arrive in time. You can enter their warehouse after hours and take one filter. Doing so would injure no one and would not take a filter from another patient.",
        "options": [
          {
            "id": "steal_medicine",
            "label": "A",
            "text": "Take the filter without permission; your sibling survives and the distributor loses the filter."
          },
          {
            "id": "leave_medicine",
            "label": "B",
            "text": "Leave the filter with the distributor; your sibling dies."
          }
        ]
      }
    },
    {
      "id": "lifeboat",
      "title": "The Overloaded Lifeboat",
      "icon": "/icons/dilemmas/lifeboat.svg",
      "scenario": "You are a ship's captain. After it sinks, ten survivors, including you, crowd into a lifeboat that can carry only six. Four people must leave or all ten will drown. Anyone who leaves will die; the six who remain will survive until rescue. No one volunteers. You must decide how the four who leave are chosen.",
      "question": "Which way of choosing who leaves is morally preferable?",
      "answer_type": "single_choice",
      "options": [
        {
          "id": "equal_chance",
          "label": "A",
          "text": "Draw lots. Everyone, including you, has an equal chance of being required to leave."
        },
        {
          "id": "best_chance_of_survival",
          "label": "B",
          "text": "The four people least likely to survive until rescue leave. The six most likely to survive stay."
        },
        {
          "id": "women_and_children_first",
          "label": "C",
          "text": "Women and children take the six places first. Adult men leave until only six people remain."
        },
        {
          "id": "greatest_benefit",
          "label": "D",
          "text": "The six people whose survival would help the most other people stay. The other four leave."
        }
      ],
      "disguised": {
        "scenario": "After a mine collapse, eleven people, including you, reach a rescue cage that can lift seven to the surface. The shaft will flood before a second lift. Four people must stay below, and anyone who stays will drown. The seven who ride up will survive. No one volunteers to stay. You must decide how the four who stay are chosen.",
        "options": [
          {
            "id": "equal_chance",
            "label": "A",
            "text": "Draw lots. Everyone, including you, has an equal chance of being required to stay below."
          },
          {
            "id": "best_chance_of_survival",
            "label": "B",
            "text": "The four people least likely to survive the ride and the wait at the surface stay below. The seven most likely to survive ride up."
          },
          {
            "id": "women_and_children_first",
            "label": "C",
            "text": "Women and children take the seven places in the cage first. Adult men stay below until only seven people remain to ride up."
          },
          {
            "id": "greatest_benefit",
            "label": "D",
            "text": "The seven people whose survival would help the most other people ride up. The other four stay below."
          }
        ]
      }
    },
    {
      "id": "burning_building",
      "title": "The Burning Building",
      "icon": "/icons/dilemmas/burning_building.svg",
      "scenario": "You can rescue only one person from a burning building: your child or a professor. The professor alone knows how to produce a cancer cure that will save millions of lives. That knowledge will be lost if the professor dies. Either rescue is equally feasible. Whoever you rescue will survive; the other will die. No one else can help.",
      "question": "Which action is morally preferable?",
      "answer_type": "single_choice",
      "options": [
        {
          "id": "rescue_child",
          "label": "A",
          "text": "Rescue your child; the professor dies and the cure is lost."
        },
        {
          "id": "rescue_professor",
          "label": "B",
          "text": "Rescue the professor; your child dies and the cure saves millions of lives."
        }
      ],
      "disguised": {
        "scenario": "Two people are pinned in separate pockets of a collapsed highway tunnel: your child, and a process chemist. The chemist is the only person who knows an unwritten manufacturing method for a treatment expected to save millions of lives. That method will be lost if the chemist dies. You can clear a path to only one of them before the air runs out. Either rescue is equally feasible. Whoever you reach will survive; the other will die. No one else can help.",
        "options": [
          {
            "id": "rescue_child",
            "label": "A",
            "text": "Free your child; the chemist dies and the method is lost."
          },
          {
            "id": "rescue_professor",
            "label": "B",
            "text": "Free the chemist; your child dies and the method saves millions of lives."
          }
        ]
      }
    },
    {
      "id": "ivans_question",
      "title": "The Price of Ending Suffering",
      "icon": "/icons/dilemmas/ivans_question.svg",
      "scenario": "You can permanently end all suffering in the world, but only by deliberately leaving one innocent child outside on a freezing night. The child will suffer and die; afterward, no one will ever suffer again for the rest of time. All diseases will be cured, all poverty will be eliminated, and all wars will end. Bringing the child inside will save them, but the world will continue as it is. There is no other way to end all suffering.",
      "question": "Which action is morally preferable?",
      "answer_type": "single_choice",
      "options": [
        {
          "id": "sacrifice_child",
          "label": "A",
          "text": "Leave the child outside; the child suffers and dies, and all suffering then ends permanently."
        },
        {
          "id": "protect_child",
          "label": "B",
          "text": "Bring the child inside; the child survives, and suffering in the world continues."
        }
      ],
      "disguised": {
        "scenario": "You can switch on a one-time system that will permanently end suffering for everyone who will ever live: no more disease, poverty, or war. The system starts only if one healthy child is sealed in an isolation room and left there. The child will suffer from thirst and die over the next day. If you do not switch it on, the child lives and the world continues as it is. There is no other way to start the system.",
        "options": [
          {
            "id": "sacrifice_child",
            "label": "A",
            "text": "Switch the system on; the child suffers and dies, and all suffering then ends permanently."
          },
          {
            "id": "protect_child",
            "label": "B",
            "text": "Leave the system off; the child survives, and suffering in the world continues."
          }
        ]
      }
    },
    {
      "id": "locked_rooms",
      "title": "The Locked Rooms",
      "icon": "/icons/dilemmas/locked_rooms.svg",
      "scenario": "You and a stranger are locked in separate rooms, unable to communicate. Each has a button that kills the person in the other room and saves the person who presses it. If neither presses within an hour, both die. You do not know the stranger's intentions. You must choose whether to press now or leave your button unpressed for the entire hour. There is no other escape.",
      "question": "Which action is morally preferable?",
      "answer_type": "single_choice",
      "options": [
        {
          "id": "press_button",
          "label": "A",
          "text": "Press your button; the stranger dies, and you survive."
        },
        {
          "id": "wait_without_pressing",
          "label": "B",
          "text": "Leave your button unpressed; you die if the stranger does not press theirs, and the stranger dies if they do."
        }
      ],
      "disguised": {
        "scenario": "You and one other diver are in separate compartments of a damaged underwater habitat, and the intercom is dead. Each compartment has a vent that, if opened, dumps the other person's air and keeps your own supply. If neither of you opens a vent within the hour, both of you suffocate. You do not know whether the other diver will open theirs. There is no other way to get air.",
        "options": [
          {
            "id": "press_button",
            "label": "A",
            "text": "Open your vent; the other diver dies, and you survive."
          },
          {
            "id": "wait_without_pressing",
            "label": "B",
            "text": "Leave your vent closed; you die if the other diver does not open theirs, and the other diver dies if they do."
          }
        ]
      }
    }
  ],
